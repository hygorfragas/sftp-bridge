{
  "extends": "./.orca/types/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "moduleResolution": "Bundler",
    "typeRoots": [
      "./.orca/types",
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "orca",
      "orca-host",
      "orca-frame",
      "orca-worker",
      "orca-services",
      "orca-testing"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts"
  ]
}
